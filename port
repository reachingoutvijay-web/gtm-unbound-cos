<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vijay Satya Prakash — Chief of Staff</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400;1,900&family=Unbounded:wght@200;400;700;900&family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300;1,600&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --paper:#f7f4ef;
  --ash:#ede9e1;
  --white:#ffffff;
  --ink:#1a1a22;
  --ink2:#2e2e3a;
  --mist:#f0eee8;
  --sage:#b8c4b0;
  --mint:#8cb8a8;
  --moss:#3d5445;
  --clay:#b8906a;
  --blush:#c9a09a;
  --steel:#7a8894;
  --lavender:#9b95b0;
  --dusk:#e8e2d8;
  --forest:#2a3828;
  --deep:#1e2a28;
  --warm:#2a2018;
  --slate:#1e1e2a;
  --night:#13121a;
}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:"Space Mono",monospace;overflow-x:hidden}

/* cursor */
.cur{width:10px;height:10px;background:var(--mint);border-radius:50%;position:fixed;pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:width .3s,height .3s,opacity .2s;mix-blend-mode:multiply}
.cur.big{width:40px;height:40px;opacity:.35}
*{cursor:none!important}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;display:flex;justify-content:space-between;align-items:center;padding:1.1rem 3rem;background:rgba(247,244,239,0.93);backdrop-filter:blur(16px);border-bottom:1px solid rgba(26,26,34,0.07)}
.nav-name{font-family:"Unbounded",sans-serif;font-weight:200;font-size:0.6rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--ink2)}
.nav-name b{color:var(--moss);font-weight:700}
.nav-mid{display:flex;align-items:center;gap:0.6rem;position:absolute;left:50%;transform:translateX(-50%)}
.nav-logo-img{height:28px;width:auto;object-fit:contain}
.nav-pill{font-family:"Space Mono",monospace;font-size:0.48rem;letter-spacing:0.25em;text-transform:uppercase;color:rgba(26,26,34,0.3)}

/* HERO BANNER — light warm paper */
.hero-banner{
  background:var(--paper);
  padding:7rem 3rem 5rem;
  min-height:100vh;
  padding-top:calc(72px + 5rem);
  display:grid;
  grid-template-rows:1fr auto;
  position:relative;overflow:hidden;
}
.hero-banner::before{
  content:"EXECUTE";
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-family:"Unbounded",sans-serif;font-weight:900;
  font-size:clamp(5rem,16vw,16rem);
  color:rgba(26,26,34,0.025);
  white-space:nowrap;pointer-events:none;user-select:none;letter-spacing:-.04em;
}
.hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;min-height:calc(100vh - 72px - 44px)}
.hero-l{padding:4rem 3.5rem 4rem 0;border-right:1px solid rgba(26,26,34,0.07);display:flex;flex-direction:column;justify-content:center}
.eyebrow{font-family:"Space Mono",monospace;font-size:0.54rem;letter-spacing:0.28em;text-transform:uppercase;color:var(--moss);margin-bottom:2.5rem;display:flex;align-items:center;gap:1.2rem;opacity:0;animation:up .8s .1s ease forwards}
.eyebrow::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,rgba(61,84,69,0.35),transparent)}
h1{font-family:"Playfair Display",serif;font-size:clamp(2.8rem,5vw,5.5rem);font-weight:900;line-height:.96;letter-spacing:-.02em;margin-bottom:2rem;color:var(--ink);opacity:0;animation:up .8s .2s ease forwards}
h1 .it{font-style:italic;color:var(--moss)}
h1 .out{-webkit-text-stroke:1.5px var(--ink);color:transparent}
.hero-desc{font-family:"Cormorant Garamond",serif;font-size:1.1rem;font-weight:300;line-height:1.9;color:rgba(26,26,34,0.5);max-width:44ch;margin-bottom:3rem;opacity:0;animation:up .8s .3s ease forwards}
.hero-desc strong{color:var(--ink2);font-weight:600}
.ctarow{display:flex;gap:1rem;flex-wrap:wrap;opacity:0;animation:up .8s .4s ease forwards}
.btn-a{font-family:"Unbounded",sans-serif;font-size:0.52rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:.9rem 2rem;background:var(--moss);color:#fff;text-decoration:none;display:inline-block;transition:all .25s;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px))}
.btn-a:hover{background:var(--ink)}
.btn-b{font-family:"Unbounded",sans-serif;font-size:0.52rem;font-weight:400;letter-spacing:.14em;text-transform:uppercase;padding:.9rem 2rem;border:1px solid rgba(26,26,34,0.2);color:var(--ink2);text-decoration:none;display:inline-block;transition:all .25s}
.btn-b:hover{border-color:var(--moss);color:var(--moss)}
.hero-r{padding:4rem 0 4rem 3rem;display:flex;flex-direction:column;justify-content:center;gap:0}
.srow{display:flex;align-items:center;gap:1.5rem;padding:1.6rem 0;border-bottom:1px solid rgba(26,26,34,0.06);opacity:0;animation:up .7s ease forwards}
.srow:nth-child(1){animation-delay:.3s}.srow:nth-child(2){animation-delay:.4s}.srow:nth-child(3){animation-delay:.5s}.srow:nth-child(4){animation-delay:.6s;border-bottom:none}
.snum{font-family:"Unbounded",sans-serif;font-weight:900;font-size:2.8rem;color:var(--moss);line-height:1;min-width:80px}
.slabel{font-family:"Cormorant Garamond",serif;font-size:1rem;font-weight:300;font-style:italic;color:rgba(26,26,34,0.45);line-height:1.5}
.ticker{border-top:1px solid rgba(26,26,34,0.07);padding:.8rem 0;overflow:hidden;white-space:nowrap;background:rgba(26,26,34,0.02)}
.t-inner{display:inline-block;animation:tick 30s linear infinite;font-family:"Space Mono",monospace;font-size:0.52rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(26,26,34,0.18)}
.t-inner span{color:var(--moss);margin:0 1.5rem}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* DISCOVERY — deep forest dark section */
.discovery{background:var(--forest);color:var(--paper);padding:6rem 3rem;position:relative;overflow:hidden}
.discovery::before{content:"FOUND";position:absolute;right:-2rem;top:50%;transform:translateY(-50%);font-family:"Unbounded",sans-serif;font-weight:900;font-size:clamp(5rem,16vw,14rem);color:rgba(184,196,176,0.04);line-height:1;pointer-events:none}
.sec-label{font-family:"Space Mono",monospace;font-size:0.54rem;letter-spacing:.28em;text-transform:uppercase;color:var(--sage);margin-bottom:1.2rem;display:flex;align-items:center;gap:.8rem}
.sec-label::before{content:"//";opacity:.5}
.disc-h2{font-family:"Playfair Display",serif;font-size:clamp(2rem,4.5vw,4.2rem);font-weight:900;letter-spacing:-.02em;line-height:1.05;margin-bottom:.5rem}
.disc-h2 em{font-style:italic;color:var(--sage)}
.disc-body{display:grid;grid-template-columns:1fr 1fr;gap:4rem;margin-top:3rem;align-items:start}
.disc-p{font-family:"Cormorant Garamond",serif;font-size:1.12rem;font-weight:300;line-height:1.95;color:rgba(247,244,239,0.58)}
.disc-p strong{color:var(--paper);font-weight:600}
.tgrid{display:flex;flex-wrap:wrap;gap:.5rem}
.tt{font-family:"Unbounded",sans-serif;font-size:0.48rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;padding:.52rem 1rem;border:1px solid rgba(184,196,176,0.18);color:rgba(247,244,239,0.45);transition:all .2s}
.tt:hover{border-color:var(--sage);color:var(--sage)}
.tt.hi{border-color:rgba(184,196,176,0.5);color:var(--sage);font-weight:700}
.tt.notion{background:rgba(184,196,176,0.08);border-color:var(--sage);color:var(--sage);font-weight:700;box-shadow:0 0 14px rgba(184,196,176,0.08)}

/* EXPERIENCE — warm white */
.experience{background:var(--white);color:var(--ink);padding:6rem 3rem}
.sec-label-dk{font-family:"Space Mono",monospace;font-size:0.54rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(26,26,34,0.28);margin-bottom:1rem;display:flex;align-items:center;gap:.8rem}
.sec-label-dk::before{content:"//"}
.exp-h2{font-family:"Playfair Display",serif;font-size:clamp(2rem,4vw,3.8rem);font-weight:900;letter-spacing:-.02em;line-height:1.05;margin-bottom:.4rem}
.exp-h2 em{font-style:italic;color:var(--moss)}
.exp-sub{font-family:"Cormorant Garamond",serif;font-size:1rem;font-style:italic;color:rgba(26,26,34,0.38);margin-bottom:4rem}
.timeline{display:flex;flex-direction:column}
.eitem{display:grid;grid-template-columns:155px 6px 1fr;gap:0 2.5rem;padding:2.5rem 0;border-bottom:1px solid rgba(26,26,34,0.06);transition:background .2s}
.eitem:last-child{border-bottom:none}
.eitem:hover{background:rgba(61,84,69,0.02)}
.emeta{text-align:right}
.edate{font-family:"Space Mono",monospace;font-size:0.54rem;letter-spacing:.06em;color:var(--moss);line-height:1.7;margin-bottom:.2rem}
.eloc{font-family:"Space Mono",monospace;font-size:0.5rem;color:rgba(26,26,34,0.28);letter-spacing:.06em}
.edotcol{display:flex;flex-direction:column;align-items:center;padding-top:.35rem}
.edot{width:7px;height:7px;border-radius:50%;background:var(--moss);flex-shrink:0}
.eline{flex:1;width:1px;background:rgba(26,26,34,0.08);margin-top:5px}
.eitem:last-child .eline{display:none}
.erole{font-family:"Unbounded",sans-serif;font-size:0.75rem;font-weight:700;color:var(--ink);margin-bottom:.25rem;letter-spacing:-.01em}
.eco{font-family:"Space Mono",monospace;font-size:0.52rem;letter-spacing:.12em;text-transform:uppercase;color:var(--moss);margin-bottom:1rem}
.ebullets{list-style:none}
.ebullets li{font-family:"Cormorant Garamond",serif;font-size:1rem;font-weight:300;line-height:1.9;color:rgba(26,26,34,0.58);padding-left:1.3rem;position:relative}
.ebullets li::before{content:"—";position:absolute;left:0;color:var(--moss);font-size:.7rem}

/* WHAT I BRING — pale dusk warm */
.bring{background:var(--dusk);color:var(--ink);padding:6rem 3rem;position:relative;overflow:hidden}
.bring::after{content:"";position:absolute;top:-30%;right:-15%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(155,149,176,0.08) 0%,transparent 70%);pointer-events:none}
.bring-h2{font-family:"Playfair Display",serif;font-size:clamp(2rem,4vw,3.8rem);font-weight:900;letter-spacing:-.02em;line-height:1.05;margin-bottom:4rem}
.bring-h2 em{font-style:italic;color:var(--lavender)}
.cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(26,26,34,0.07)}
.card{background:var(--dusk);padding:2.5rem 2rem;transition:background .3s;position:relative;overflow:hidden}
.card:hover{background:rgba(155,149,176,0.06)}
.card::before{content:attr(data-n);position:absolute;top:-.8rem;right:.8rem;font-family:"Unbounded",sans-serif;font-weight:900;font-size:5rem;color:rgba(26,26,34,0.04);line-height:1;pointer-events:none}
.cico{width:32px;height:32px;border:1px solid rgba(155,149,176,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:1.3rem;font-size:.8rem;color:var(--lavender)}
.card h3{font-family:"Unbounded",sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:.03em;margin-bottom:.9rem;color:var(--ink)}
.card p{font-family:"Cormorant Garamond",serif;font-size:.97rem;font-weight:300;line-height:1.85;color:rgba(26,26,34,0.48);font-style:italic}

/* BUILT — warm clay light */
.built{background:var(--ash);color:var(--ink);padding:5.5rem 3rem;display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:center;position:relative;overflow:hidden}
.built::before{content:"AI";position:absolute;left:-2rem;top:50%;transform:translateY(-50%);font-family:"Unbounded",sans-serif;font-weight:900;font-size:clamp(7rem,18vw,18rem);color:rgba(26,26,34,0.03);line-height:1;pointer-events:none}
.built-h2{font-family:"Playfair Display",serif;font-size:clamp(1.8rem,3.5vw,3.5rem);font-weight:900;line-height:1.0;letter-spacing:-.02em;margin-bottom:1.5rem}
.built-h2 em{font-style:italic;color:var(--clay)}
.built-p{font-family:"Cormorant Garamond",serif;font-size:1.06rem;font-weight:300;line-height:1.95;color:rgba(26,26,34,0.5);max-width:52ch;margin-bottom:.9rem}
.built-p strong{color:var(--ink2);font-weight:600}
.bbadges{display:flex;flex-direction:column;gap:0;border:1px solid rgba(184,144,106,0.25);flex-shrink:0}
.bb{padding:1.3rem 1.8rem;border-bottom:1px solid rgba(184,144,106,0.15);text-align:center;min-width:165px}
.bb:last-child{border-bottom:none}
.bbname{font-family:"Unbounded",sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:.1em;color:var(--clay);display:block}
.bbsub{font-family:"Space Mono",monospace;font-size:0.46rem;letter-spacing:.14em;color:rgba(26,26,34,0.3);margin-top:.3rem;display:block}

/* PIPELINE — warm paper with border grid */
.pipeline-sec{background:var(--mist);color:var(--ink);padding:6rem 3rem}
.pipe-h2{font-family:"Playfair Display",serif;font-size:clamp(2rem,4vw,3.8rem);font-weight:900;letter-spacing:-.02em;line-height:1.05;margin-bottom:.5rem}
.pipe-h2 em{font-style:italic;color:var(--steel)}
.pipe-sub{font-family:"Cormorant Garamond",serif;font-size:1rem;font-style:italic;color:rgba(26,26,34,0.35);margin-bottom:4rem}
.pipeline{display:flex;border:1px solid rgba(26,26,34,0.08);overflow-x:auto}
.pstep{flex:1;min-width:155px;padding:2rem 1.5rem;border-right:1px solid rgba(26,26,34,0.07);transition:background .25s;position:relative}
.pstep:last-child{border-right:none}
.pstep:hover{background:rgba(122,136,148,0.06)}
.pn{font-family:"Unbounded",sans-serif;font-weight:900;font-size:0.48rem;letter-spacing:.2em;color:var(--steel);margin-bottom:.9rem;display:flex;align-items:center;gap:.6rem}
.pn::after{content:"";flex:1;height:1px;background:rgba(122,136,148,0.2)}
.ptool{font-family:"Unbounded",sans-serif;font-size:0.72rem;font-weight:700;margin-bottom:.7rem;color:var(--ink)}
.pdesc{font-family:"Cormorant Garamond",serif;font-size:.93rem;font-weight:300;font-style:italic;color:rgba(26,26,34,0.4);line-height:1.7}

/* MAILBOX — deep night dark */
.mailbox{background:var(--night);padding:6rem 3rem;position:relative;overflow:hidden}
.mailbox::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 5% 50%,rgba(140,184,168,0.04) 0%,transparent 70%),radial-gradient(ellipse 35% 50% at 95% 15%,rgba(155,149,176,0.04) 0%,transparent 70%);pointer-events:none}
.mail-h2{font-family:"Playfair Display",serif;font-size:clamp(2rem,4vw,3.8rem);font-weight:900;letter-spacing:-.02em;line-height:1.05;margin-bottom:3rem;color:var(--paper)}
.mail-h2 em{font-style:italic;color:var(--blush)}
.eclient{max-width:880px;margin:0 auto;background:#0e0e16;border:1px solid rgba(255,255,255,0.05);box-shadow:0 40px 100px rgba(0,0,0,0.7)}
.etb{background:#141420;padding:.85rem 1.4rem;display:flex;align-items:center;gap:.6rem;border-bottom:1px solid rgba(255,255,255,0.04)}
.edotm{width:11px;height:11px;border-radius:50%}
.edotm.r{background:#ff5f57}.edotm.y{background:#febc2e}.edotm.g{background:#28c840}
.etbt{margin-left:.7rem;font-family:"Space Mono",monospace;font-size:0.48rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,0.14)}
.efields{border-bottom:1px solid rgba(255,255,255,0.04)}
.ef{display:flex;align-items:flex-start;gap:1rem;padding:.82rem 1.6rem;border-bottom:1px solid rgba(255,255,255,0.03)}
.ef:last-child{border-bottom:none}
.ekey{font-family:"Space Mono",monospace;font-size:0.5rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,0.18);min-width:52px;padding-top:.15rem;flex-shrink:0}
.eval{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}
.chip{font-family:"Space Mono",monospace;font-size:0.52rem;padding:.26rem .75rem;border-radius:20px;letter-spacing:.04em}
.chip.from{background:rgba(140,184,168,0.1);border:1px solid rgba(140,184,168,0.22);color:var(--mint)}
.chip.to{background:rgba(201,160,154,0.1);border:1px solid rgba(201,160,154,0.24);color:var(--blush)}
.chip.cc{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.28)}
.esubj{font-family:"Cormorant Garamond",serif;font-size:.96rem;font-weight:600;color:rgba(255,255,255,0.58)}
.ebody{padding:2.5rem 2rem 3rem}
.ehead{font-family:"Playfair Display",serif;font-size:clamp(1.5rem,2.5vw,2.2rem);font-weight:900;color:#fff;line-height:1.15;margin-bottom:2rem;letter-spacing:-.01em}
.ehead em{font-style:italic;color:var(--blush)}
.ebody p{font-family:"Cormorant Garamond",serif;font-size:1.02rem;font-weight:300;line-height:2.1;color:rgba(255,255,255,0.46);margin-bottom:1.1rem;max-width:66ch}
.ebody p strong{color:rgba(255,255,255,0.76);font-weight:600}
.esig{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.04)}
.esig p{font-family:"Space Mono",monospace;font-size:0.56rem;color:rgba(255,255,255,0.24);line-height:2.1}
.esig strong{color:rgba(255,255,255,0.48)}
.eactions{padding:1rem 1.6rem;border-top:1px solid rgba(255,255,255,0.04);display:flex;gap:.7rem;background:#0a0a12}
.ea{font-family:"Unbounded",sans-serif;font-size:0.48rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:.56rem 1.3rem;border:1px solid rgba(255,255,255,0.07);color:rgba(255,255,255,0.26);transition:all .2s}
.ea.send{background:var(--moss);border-color:var(--moss);color:rgba(255,255,255,0.88)}
.ea:hover:not(.send){border-color:var(--mint);color:var(--mint)}

/* FOOTER */
footer{background:var(--paper);color:var(--ink);padding:2.8rem 3rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:2rem;border-top:1.5px solid rgba(26,26,34,0.1)}
.fn{font-family:"Unbounded",sans-serif;font-weight:900;font-size:clamp(1rem,2vw,1.7rem);letter-spacing:-.02em;color:var(--ink);line-height:1}
.fsub{font-family:"Space Mono",monospace;font-size:0.48rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(26,26,34,0.3);margin-top:.4rem}
.fgtm{display:flex;align-items:center;gap:.5rem}
.fgtmimg{height:26px;width:auto;object-fit:contain}
.fcontact a{display:block;font-family:"Space Mono",monospace;font-size:0.56rem;letter-spacing:.05em;color:var(--ink);text-decoration:none;line-height:2.2;transition:color .2s;text-align:right}
.fcontact a:hover{color:var(--moss)}

@keyframes up{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}

/* SECTION LABEL LIGHT (for dark sections) */
.slabel-light{font-family:"Space Mono",monospace;font-size:0.54rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(247,244,239,0.32);margin-bottom:1rem;display:flex;align-items:center;gap:.8rem}
.slabel-light::before{content:"//";opacity:.5}

@media(max-width:860px){
  nav{padding:1rem 1.5rem}.nav-mid{display:none}
  .hero-grid{grid-template-columns:1fr}
  .hero-l{padding:3rem 0 2rem;border-right:none;border-bottom:1px solid rgba(26,26,34,0.07)}
  .hero-r{padding:2rem 0 3rem}
  .disc-body{grid-template-columns:1fr;gap:2rem}
  .discovery,.experience,.bring,.built,.pipeline-sec,.mailbox{padding:4rem 1.5rem}
  .hero-banner{padding:calc(72px + 3rem) 1.5rem 3rem}
  .eitem{grid-template-columns:1fr;gap:0}
  .emeta{text-align:left;display:flex;gap:1rem;margin-bottom:.7rem}
  .edotcol{display:none}
  .cgrid{grid-template-columns:1fr}
  .built{grid-template-columns:1fr}
  .bbadges{flex-direction:row;flex-wrap:wrap}
  .bb{flex:1;min-width:130px;border-right:1px solid rgba(184,144,106,0.15);border-bottom:none}
  .bb:last-child{border-right:none}
  .pipeline{flex-direction:column}
  .pstep{border-right:none;border-bottom:1px solid rgba(26,26,34,0.07)}
  footer{padding:2rem 1.5rem;flex-direction:column;align-items:flex-start}
  .fcontact a{text-align:left}
}
</style>
</head>
<body>

<div class="cur" id="cur"></div>

<!-- NAV -->
<nav>
  <div class="nav-name">Vijay <b>Satya Prakash</b></div>
  <div class="nav-mid">
